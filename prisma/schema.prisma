datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
  }

  generator client {
    provider = "prisma-client-js"
  }

  model User {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    email        String   @unique
    name         String
    image        String?
    calendarName       String?
    personalCalendarIcs String?
    calendarEvents     Json?
    aiPromptNotes      String?
    customCals         CustomCalendar[]
  }

  model Friendship {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    senderId   String
    receiverId String
    status     String   @default("PENDING")

    @@unique([senderId, receiverId])
  }

  model FriendGroup {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    ownerEmail  String
    name        String
    friendEmails String[]
    isActive    Boolean  @default(true)
  }

  model CustomCalendar {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    ownerId    String   @db.ObjectId
    name       String
    eventsJson Json
    sourceIcs  String?
    owner      User     @relation(fields: [ownerId], references: [id])
  }

  model CustomEvent {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    userId      String   @db.ObjectId
    batchId     String
    title       String
    description String?
    startTime   DateTime
    endTime     DateTime
    category    String
    color       String
    createdAt   DateTime @default(now())

    @@index([userId])
    @@index([batchId])
  }